# Copy to .env and fill in ELASTICSEARCH_PASSWORD
APP_PORT=8181
DB_PORT=3316
DB_PASSWORD=laporjalan
DB_ROOT_PASSWORD=root

# Your local Elasticsearch (seen from inside Docker)
ELASTICSEARCH_HOST=https://host.docker.internal:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=
ELK_VERSION=8.19.15

# Host user id, so files written by Apache stay owned by you
UID=1000
GID=1000

# Dipakai tombol "Buka Kibana" di menu Monitor Logging (dibuka dari browser)
KIBANA_URL=http://localhost:5601
