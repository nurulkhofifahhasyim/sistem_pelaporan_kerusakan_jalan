{
  "index_patterns": ["app-logs-*"],
  "priority": 200,
  "template": {
    "settings": { "number_of_shards": 1, "number_of_replicas": 0 },
    "mappings": {
      "properties": {
        "@timestamp":  { "type": "date" },
        "level":       { "type": "keyword" },
        "app_name":    { "type": "keyword" },
        "application": { "type": "keyword" },
        "environment": { "type": "keyword" },
        "type":        { "type": "keyword" },
        "tags":        { "type": "keyword" },
        "request_id":  { "type": "keyword" },
        "message": {
          "type": "text",
          "fields": { "keyword": { "type": "keyword", "ignore_above": 512 } }
        },
        "http": {
          "properties": {
            "method":      { "type": "keyword" },
            "endpoint": {
              "type": "keyword", "ignore_above": 1024,
              "fields": { "text": { "type": "text" } }
            },
            "ip_address":  { "type": "keyword" },
            "user_agent":  { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 512 } } },
            "status_code": { "type": "integer" },
            "duration_ms": { "type": "float" }
          }
        },
        "actor": {
          "properties": {
            "user_id": { "type": "keyword" },
            "role":    { "type": "keyword" }
          }
        },
        "context":      { "type": "flattened", "ignore_above": 8191 },
        "context_text": { "type": "text" },
        "event":        { "type": "object", "enabled": false },
        "log":          { "type": "object", "enabled": false }
      }
    }
  }
}
